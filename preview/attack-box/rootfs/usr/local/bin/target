#!/bin/sh
# Says where the lab machine is and which of its ports are open.
ip=$(getent hosts target | awk '{print $1; exit}')
if [ -z "$ip" ]; then
  echo "No lab machine is attached. Start one on the lab page, then run this again."
  exit 1
fi
echo "target is $ip. Looking for open ports..."
nmap -n -Pn --open -p- --min-rate 2000 -T4 "$ip" | grep -E '^[0-9]+/|^PORT' || echo "No open port answered."
