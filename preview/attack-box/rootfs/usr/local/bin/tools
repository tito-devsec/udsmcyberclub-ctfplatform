#!/bin/sh
# Lists the tools installed in the attack box, by what they are for.
b=$(printf '\033[1;38;2;245;184;46m'); n=$(printf '\033[0m')
cat <<LIST

${b}Looking around${n}      nmap  target  ping  dig  curl  wget  nc  ncat  socat  telnet  ftp  ssh
${b}Web${n}                 sqlmap  ffuf  gobuster  dirb  nikto  whatweb  curl
${b}Passwords${n}           john  hashcat  hydra  hashid      wordlists in /usr/share/wordlists
${b}Crypto and coding${n}   python3 (pwntools, pycryptodome, requests, scapy, pymodbus, PIL)  openssl  gpg  xxd
${b}Files and forensics${n} file  strings  binwalk  foremost  exiftool  pdftotext  sqlite3  7z  unzip  mmls  fls
${b}Pictures${n}            steghide  pngcheck  identify  convert  exiftool
${b}Network captures${n}    tshark  tcpdump  scapy
${b}Programs${n}            gdb  radare2 (r2)  ltrace  strace  objdump  readelf  gcc  make  pwn checksec
${b}Editors and shell${n}   nano  vim  less  tmux  jq  tree  htop

Something missing?  apt install <package>  and  pip install <package>  work for the
packages your club's admins have approved. Ask them to add what a lab needs.

LIST
