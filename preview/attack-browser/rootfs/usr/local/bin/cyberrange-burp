#!/bin/sh
# Burp Suite's screen, started when a student first opens Burp's window in the attack box: a
# second VNC server (display :1) that, like Firefox's, nothing outside this container can reach
# (the CyberRange service connects to it through Docker), a window manager that keeps Burp
# filling it, and Burp, opened again if it is closed. Run again while that screen is up, it does
# nothing. It returns once the screen is ready, while Burp goes on starting on it.
#
# Burp listens on 127.0.0.1:8080. Firefox sends it what it opens on the lab machine ("target")
# and the box ("box") whenever Burp runs (see /etc/cyberrange/proxy.pac). Burp gets no further
# than Firefox does: the lab machine, the box, and websites only through the club's proxy.
#
# "cyberrange-burp ready" succeeds once Burp's window is on its screen: Java takes a minute or so.
if [ "$1" = ready ]; then
  DISPLAY=:1 xwininfo -root -tree 2> /dev/null | grep -q '"Burp Suite'
  exit $?
fi

pgrep -f '^Xvnc :1 ' > /dev/null && exit 0

rm -f /tmp/.X1-lock /tmp/.X11-unix/X1
Xvnc :1 -geometry 1280x800 -depth 24 -rfbport 5901 -localhost -SecurityTypes None -AlwaysShared \
  -desktop 'Burp Suite' -nolisten tcp -dpi 96 > /tmp/xvnc-burp.log 2>&1 < /dev/null &

waited=0
while [ ! -S /tmp/.X11-unix/X1 ] && [ "$waited" -lt 100 ]; do
  sleep 0.1
  waited=$((waited + 1))
done
if [ ! -S /tmp/.X11-unix/X1 ]; then
  echo "Burp's screen did not start." >&2
  exit 1
fi

export DISPLAY=:1
# the attack box's own dark grey behind Burp's windows, rather than X's black
xsetroot -solid '#1f232b' > /dev/null 2>&1
openbox --config-file /etc/cyberrange/openbox-burp.xml > /tmp/openbox-burp.log 2>&1 < /dev/null &
# copying and pasting between Burp and the student's own computer
vncconfig -nowin > /dev/null 2>&1 < /dev/null &

# Burp's share of memory comes from the service (BURP_HEAP_MB), inside what it adds to this
# container's limit for Burp. Text is smoothed, as on a desktop. Java's quick compiler alone and
# its simplest collector are plenty for Burp's light work: next to a Firefox that is starting
# too, on two cores, Burp's first window comes in about 50 seconds instead of 60, and Java takes
# 70 MB less.
JAVA_ARGS="-Xmx${BURP_HEAP_MB:-768}m -Dawt.useSystemAAFontSettings=on -Dswing.aatext=true"
JAVA_ARGS="$JAVA_ARGS --enable-native-access=ALL-UNNAMED -XX:TieredStopAtLevel=1 -XX:+UseSerialGC"
export JAVA_ARGS
# Burp opens as on Kali: its loading screen, its terms the first time, then its two start-up
# questions (a temporary project, Burp's default settings) before its main window.
nohup sh -c 'while true; do burpsuite --disable-auto-update; sleep 1; done' \
  > /tmp/burp.log 2>&1 < /dev/null &
exit 0
