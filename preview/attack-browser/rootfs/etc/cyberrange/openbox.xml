<?xml version="1.0" encoding="UTF-8"?>
<!-- Firefox's windows fill the screen, without a frame: the attack box draws the window around
     them. Dialogs keep openbox's own frame. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <desktops>
    <number>1</number>
  </desktops>
  <applications>
    <application class="firefox-esr" type="normal">
      <decor>no</decor>
      <maximized>yes</maximized>
    </application>
    <application class="Firefox-esr" type="normal">
      <decor>no</decor>
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
