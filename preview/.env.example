# Copy this file to .env and fill in every value. .env is ignored by git.
# Passwords need an uppercase letter, a lowercase letter and a digit.

# Password for the "Admin" account, created on first start
ADMIN_PASSWORD=

# Database password, used only between the two containers
POSTGRES_PASSWORD=

# Random string (32 characters works well) used to encrypt each game's signing key.
# Keep it the same for the life of the database.
XOR_KEY=

# Logins created by seed-demo.mjs
TEST_USER_NAME=testuser
TEST_USER_PASSWORD=
DEMO_PLAYER_PASSWORD=
