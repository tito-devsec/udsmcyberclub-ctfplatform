# Copy this file to .env and fill in every value. .env is ignored by git.
# Passwords need an uppercase letter, a lowercase letter and a digit.

# Password for the "Admin" account, created on first start
ADMIN_PASSWORD=

# Database password, used only between the containers. Letters and digits only:
# the CyberRange service also puts it in a connection URL.
POSTGRES_PASSWORD=

# Random string (32 characters works well) used to encrypt each game's signing key.
# Keep it the same for the life of the database.
XOR_KEY=

# Random string, at least 32 characters, from which the CyberRange service works out every
# student's own machine flags. Keep it secret, and keep it the same, or students' flags change.
RANGE_SECRET=

# Platform admins who may hand out the tutor role, by user name or user id, separated by
# commas. Leave it out for "Admin". On a real server use the user id, which never changes.
SUPERADMINS=Admin

# Logins created by seed-demo.mjs
TEST_USER_NAME=testuser
TEST_USER_PASSWORD=
DEMO_PLAYER_PASSWORD=
